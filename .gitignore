# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- frontend (Next.js) ------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.vercel

# --- backend (Python) ---------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/data/*.db
backend/data/resumes/*
!backend/data/resumes/.gitkeep
backend/data/screenshots/*
!backend/data/screenshots/.gitkeep
backend/config/credentials.json
backend/config/token.json

# --- secrets / env -------------------------------------------------------
.env
.env.*
!.env.example

# --- testing ---------------------------------------------------------------
coverage/

# --- misc ------------------------------------------------------------------
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local Netlify folder
.netlify
