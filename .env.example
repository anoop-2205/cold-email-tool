# Copy this file to .env in the repo root and fill in your own values.
# Read by backend/config.py. Never commit the real .env (it's gitignored).

# --- LLM provider --------------------------------------------------------
# "claude" or "ollama"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Bootstrap admin auth ---------------------------------------------------
# Seeds the first admin account on first startup. Candidates sign up
# themselves via /api/auth/register -- this is only for the one admin.
# Generate a bcrypt hash for APP_PASSWORD_HASH with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
JWT_SECRET=change-me-to-a-long-random-string
APP_USERNAME=admin
APP_PASSWORD_HASH=

# --- Job discovery / matching ----------------------------------------------
SCRAPER_INTERVAL_HOURS=6
AUTO_REJECT_BELOW=40
AUTO_APPROVE_ABOVE=80
MAX_APPLICATIONS_PER_DAY=15
# Naukri credentials are per-candidate (set in Settings in the dashboard),
# not configured here -- nothing to fill in for this app.

# --- Email Intelligence (Gmail, per-candidate OAuth) ------------------------
# credentials.json comes from Google Cloud Console (OAuth2, Web application
# type, with GMAIL_REDIRECT_URI as an authorized redirect URI) and goes in
# backend/config/credentials.json -- see README for setup steps. Each
# candidate connects their own Gmail from the Inbox page; nothing here is
# per-user, this is just the shared OAuth client.
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback
# On a container host you can't hand-copy a file in before first boot --
# paste the full contents of credentials.json here instead (leave blank
# for local dev, where the file just goes in backend/config/ directly).
GMAIL_CREDENTIALS_JSON=
FRONTEND_URL=http://localhost:3000
EMAIL_SCAN_INTERVAL_MINUTES=15

# --- CORS --------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API. Must include
# your deployed frontend's URL in production.
CORS_ORIGINS=http://localhost:3000

# --- Storage (production only) -----------------------------------------------
# Point these at a mounted persistent volume so the SQLite DB and uploaded
# resumes/screenshots survive redeploys. Leave unset for local dev.
# DATA_DIR=/data
# CONFIG_DIR=/data/config

# --- Notifications -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Browser automation ---------------------------------------------------------
PLAYWRIGHT_HEADLESS=false
# Fills application forms but does NOT click submit until you set this to false.
# Keep true until you've reviewed screenshots for your first ~20 applications.
DRY_RUN_APPLICATIONS=true

# --- Frontend (frontend/.env.local) ------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
